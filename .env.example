# =============================================================================
# Variables de entorno — RiskGuard AI Suite (Vercel)
# Copia este archivo a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables
# =============================================================================

# URL publica del sitio (sin barra final). Usada en /admin y enlaces del dashboard.
# Ejemplo produccion: https://riskguard-ai-suite.vercel.app
NEXT_PUBLIC_SITE_URL=

# Token de GitHub con permiso repo. SOLO servidor (/api/publish-menu).
# Crear en: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# Repositorio destino para menu.json (formato owner/repo)
GITHUB_REPO=aaguerrao-spec/riskguard-ai-suite

# Rama donde se commitean los cambios del menu
GITHUB_BRANCH=main

# -----------------------------------------------------------------------------
# SOLO para deploy legacy a GitHub Pages — NO configurar en Vercel
# STATIC_EXPORT=true
# -----------------------------------------------------------------------------
