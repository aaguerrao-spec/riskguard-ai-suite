# URL publica del sitio en Vercel (sin barra final)
NEXT_PUBLIC_SITE_URL=https://riskguard-ai-suite.vercel.app

# Token de GitHub para publicar menu desde /admin (serverless, no expone PAT al navegador)
GITHUB_TOKEN=

# Repo y rama donde se commitea menu.json y tools/ (default: este repo)
GITHUB_REPO=aaguerrao-spec/riskguard-ai-suite
GITHUB_BRANCH=main

# Solo para deploy legacy a GitHub Pages (npm run deploy:pages)
STATIC_EXPORT=true
